class FilesCleanerPlugin(BasePlugin):
    def on_plugin_load(self):
        self._items = []
        self._busy = False
        self._stop = False
        self._logs = []
        self._placeholder = None
        self._placeholder_doc = None
        self._status = self.get_setting("status_line", "Ничего не запускалось")

        entries = (
            ("Удалить все файлы", "msg_delete", "Фоном, пачками по 100", self._on_delete_click),
            (
                "Удалить репосты канала",
                "msg_forward",
                "Только пересланное из канала",
                self._on_forwarded_click,
            ),
            (
                "Заменить файлы на картинку",
                "msg_photo_settings",
                "Файл убрать, подпись сохранить",
                self._on_replace_click,
            ),
            (
                "Кто сколько постил",
                "msg_stats",
                "Авторы, счётчики и удаление по автору",
                self._on_authors_click,
            ),
            (
                "Удалить всех кроме своих",
                "msg_user_remove",
                "Оставить только авторов из списка",
                self._on_cleanup_click,
            ),
            ("Выделить все", "msg_select", "Отметить открытую вкладку", self._on_select_click),
        )
        try:
            item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Заглушка для замены",
                    icon="msg_photo_settings",
                    subtext="Запомнить эту картинку",
                    on_click=self._on_pick_placeholder,
                    priority=8,
                )
            )
            if item_id:
                self._items.append(item_id)
        except Exception:
            log("[files_cleaner] пункт заглушки не добавлен:\n" + traceback.format_exc())

        for menu_type in (MenuItemType.PROFILE_ACTION_MENU, MenuItemType.CHAT_ACTION_MENU):
            for text, icon, subtext, handler in entries:
                try:
                    item_id = self.add_menu_item(
                        MenuItemData(
                            menu_type=menu_type,
                            text=text,
                            icon=icon,
                            subtext=subtext,
                            on_click=handler,
                            priority=7,
                        )
                    )
                    if item_id:
                        self._items.append(item_id)
                except Exception:
                    log("[files_cleaner] меню не добавлено:\n" + traceback.format_exc())
        self.log("плагин загружен")

    def on_plugin_unload(self):
        self._stop = True
        for item_id in self._items:
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass
        self._items = []

    # ------------------------------------------------------------------
    # Лог и статус
    # ------------------------------------------------------------------

    def _note(self, line):
        stamp = time.strftime("%H:%M:%S")
        entry = "%s  %s" % (stamp, line)
        self._logs.append(entry)
        if len(self._logs) > MAX_LOG_LINES:
            del self._logs[: len(self._logs) - MAX_LOG_LINES]
        log("[files_cleaner] " + line)

    def _set_status(self, text, redraw=True):
        self._status = text
        try:
            self.set_setting("status_line", text, reload_settings=redraw)
        except Exception:
            pass

    def _log_text(self):
        if not self._logs:
            return "Лог пуст"
        return "\n".join(self._logs)

    def _copy_logs(self, view=None):
        copy_to_clipboard(self._log_text())

    def _logs_to_saved(self, view=None):
        text = self._log_text()

        def worker():
            try:
                self_id = get_user_config().getClientUserId()
                for start in range(0, len(text), REPORT_CHUNK):
                    send_text(self_id, text[start : start + REPORT_CHUNK])
                    time.sleep(0.2)
                run_on_ui_thread(lambda: BulletinHelper.show_success("Лог в «Избранном»"))
            except Exception:
                log("[files_cleaner] лог не ушёл:\n" + traceback.format_exc())
                run_on_ui_thread(lambda: BulletinHelper.show_error("Не отправился"))

        threading.Thread(target=worker, daemon=True).start()

    def _clear_logs(self, view=None):
        self._logs = []
        self._set_status(self._status)
        BulletinHelper.show_info("Лог очищен")

    def _stop_work(self, view=None):
        if not self._busy:
            BulletinHelper.show_info("Сейчас ничего не идёт")
            return
        self._stop = True
        BulletinHelper.show_info("Остановлю после текущей пачки")

    # ------------------------------------------------------------------
    # Настройки
    # ------------------------------------------------------------------

    def _placeholder_status(self):
        photo = self.get_setting("placeholder_msg", "")
        document = self.get_setting("placeholder_doc_msg", "")
        if photo and document:
            return "Готово: картинка (пост %s) и файл для альбомов (пост %s)" % (
                photo,
                document,
            )
        if photo:
            return "Картинка выбрана (пост %s). Для альбомов пометьте её же файлом" % photo
        if document:
            return "Выбран только файл (пост %s) — пометьте ещё обычную картинку" % document
        return "Ничего не выбрано — зажмите сообщение с картинкой"

    def _log_page(self):
        items = [Header(text="Лог")]
        lines = self._logs[-120:] if self._logs else ["Пусто"]
        for line in reversed(lines):
            items.append(Text(text=line))
        items.append(Divider())
        items.append(
            Text(text="Скопировать весь лог", icon="msg_copy", accent=True, on_click=self._copy_logs)
        )
        return items

    def create_settings(self):
        running = self._busy
        return [
            Header(text="Состояние"),
            Text(
                text=self._status,
                icon="msg_info",
                subtext="Обновляется по ходу работы",
            ),
            Text(
                text="Остановить" if running else "Открыть лог",
                icon="msg_cancel" if running else "msg_log",
                red=running,
                on_click=self._stop_work if running else None,
                create_sub_fragment=None if running else self._log_page,
            ),
            Text(text="Скопировать лог", icon="msg_copy", on_click=self._copy_logs),
            Text(text="Лог в «Избранное»", icon="msg_saved", on_click=self._logs_to_saved),
            Text(text="Очистить лог", icon="msg_clear", on_click=self._clear_logs),
            Divider(),
            Header(text="Замена файлов на картинку"),
            Text(
                text="Заменить файлы на картинку",
                subtext=self._placeholder_status(),
                icon="msg_photo_settings",
                accent=True,
                on_click=lambda view=None: self._on_replace_click({}),
            ),
            Divider(
                text=(
                    "Сначала зажмите в Telegram сообщение с нужной картинкой и выберите "
                    "«Заглушка для замены». Потом здесь или в меню канала запускайте замену: "
                    "файл уйдёт, подпись со всем форматированием останется."
                )
            ),
            Header(text="Удаление"),
            Text(
                text="Удалить все файлы",
                subtext="Спросит подтверждение и уйдёт работать в фон",
                icon="msg_delete",
                red=True,
                on_click=lambda view=None: self._on_delete_click({}),
            ),
            Text(
                text="Кто сколько постил",
                subtext="Все посты по авторам, с удалением по автору",
                icon="msg_stats",
                accent=True,
                on_click=lambda view=None: self._on_authors_click({}),
            ),
            Text(
                text="Удалить всех кроме своих",
                subtext="Оставит только авторов из списка ниже",
                icon="msg_user_remove",
                red=True,
                on_click=lambda view=None: self._on_cleanup_click({}),
            ),
            Input(
                key="keep_authors",
                text="Авторы, которых оставить",
                default=KEEP_AUTHORS_DEFAULT,
                subtext="Через запятую. Сравнение без учёта регистра, эмодзи и знаков.",
                icon="msg_contacts",
            ),
            Text(
                text="Удалить репосты канала",
                subtext="В чате обсуждений: только то, что прилетело из канала",
                icon="msg_forward",
                red=True,
                on_click=lambda view=None: self._on_forwarded_click({}),
            ),
            Input(
                key="source_channel",
                text="Канал-источник",
                default="",
                subtext="Пусто — определю сам: по привязке чата, иначе по содержимому.",
                icon="msg_channel",
            ),
            Text(
                text="Починить вкладку «Файлы»",
                subtext="Убрать из кэша посты, которых на сервере уже нет",
                icon="msg_reset",
                on_click=self._repair_click,
            ),
            Selector(
                key="target",
                text="Что удалять",
                default=TARGET_FILES,
                items=["Файлы (документы)", "Фото и видео", "Музыку", "Голосовые", "GIF"],
                icon="msg_media",
            ),
            Input(
                key="keep_ids",
                text="Не удалять посты",
                default=KEEP_DEFAULT,
                subtext="ID через запятую. Можно вставлять ссылки вида t.me/c/2053026588/44.",
                icon="msg_pin",
            ),
            Switch(
                key="group_channel_only",
                text="В обсуждении — только посты канала",
                default=True,
                subtext=(
                    "Сервер отдаёт лишь посты канала, а не всю переписку участников. "
                    "Выключайте, только если нужна статистика по участникам."
                ),
                icon="msg_channel",
            ),
            Switch(
                key="silent",
                text="Не отвлекать уведомлениями",
                default=False,
                subtext="Всплывающие подсказки по ходу работы отключаются, прогресс остаётся здесь.",
                icon="msg_mute",
            ),
            Divider(
                text=(
                    "Прокручивать и выделять ничего не нужно: список берётся с сервера, "
                    "удаление идёт пачками по 100 в фоне. Клиентом можно пользоваться."
                )
            ),
            Header(text="Ручное выделение"),
            Text(
                text="Выделить все на открытой вкладке",
                icon="msg_select",
                on_click=lambda view=None: self._on_select_click({}),
            ),
            Divider(
                text=(
                    "Запасной способ: отмечает загруженные элементы вкладки, дальше "
                    "штатная корзина. Telegram отмечает не больше сотни за раз."
                )
            ),
        ]

    # ------------------------------------------------------------------
    # Определение канала
    # ------------------------------------------------------------------

    def _layout(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        _, layout = _first_field(fragment, LAYOUT_FIELDS)
        return layout

    def _dialog_id(self, context):
        # Поля самого экрана точнее контекста меню — берём их первыми.
        layout = self._layout()
        if layout is not None:
            _, value = _first_field(layout, DIALOG_FIELDS)
            if value:
                normalized = _normalize_dialog(value)
                if normalized:
                    return normalized

        fragment = get_last_fragment()
        if fragment is not None:
            _, value = _first_field(fragment, DIALOG_FIELDS)
            if value:
                normalized = _normalize_dialog(value)
                if normalized:
                    return normalized

        for key in ("dialog_id", "dialogId"):
            try:
                value = (context or {}).get(key)
            except Exception:
                value = None
            if value:
                normalized = _normalize_dialog(value)
                if normalized:
                    return normalized

        try:
            chat = (context or {}).get("chat")
        except Exception:
            chat = None
        if chat is not None:
            try:
                return _normalize_dialog(int(get_private_field(chat, "id")))
            except Exception:
                pass
        return None

    # ------------------------------------------------------------------
    # Запросы
    # ------------------------------------------------------------------

    def _request(self, request, timeout=REQUEST_TIMEOUT):
        box = {}
        event = threading.Event()

        def callback(response, error):
            box["response"] = response
            box["error"] = error
            event.set()

        send_request(request, callback)
        if not event.wait(timeout):
            raise RuntimeError("Telegram не ответил за %d с" % int(timeout))
        return box.get("response"), box.get("error")

    def _request_retrying(self, request, attempts=3, timeout=REQUEST_TIMEOUT):
        last = None
        for _ in range(attempts):
            response, error = self._request(request, timeout)
            if error is None:
                return response, None
            wait = _flood_wait(error)
            last = error
            if wait <= 0 or wait > 300:
                return None, error
            self._note("флуд-контроль, жду %d с" % wait)
            time.sleep(wait + 1)
        return None, last

    def _search_page(self, dialog_id, target, offset_id):
        request = TLRPC.TL_messages_search()
        request.peer = get_messages_controller().getInputPeer(dialog_id)
        request.q = ""
        request.filter = _filter_for_target(target)
        request.min_date = 0
        request.max_date = 0
        request.offset_id = offset_id
        request.add_offset = 0
        request.limit = PAGE_LIMIT
        request.max_id = 0
        request.min_id = 0
        for field in ("hash", "hash_"):
            try:
                setattr(request, field, 0)
            except Exception:
                pass
        return request

    def _resolve_dialog(self, dialog_id, target):
        """Проверяет, какую запись id клиент вообще принимает."""
        candidates = []
        for value in (dialog_id, _bot_api_dialog(dialog_id)):
            if value and value not in candidates:
                candidates.append(value)

        last_error = None
        for candidate in candidates:
            try:
                response, error = self._request(self._search_page(candidate, target, 0))
            except Exception as exception:
                last_error = str(exception)
                continue
            if error is None:
                return candidate, response
            last_error = _error_text(error)
            self._note("id %s не подошёл: %s" % (candidate, last_error))

        raise RuntimeError("поиск не прошёл: %s" % (last_error or "неизвестно"))

    def _collect_ids(self, dialog_id, target, keep_ids):
        return [entry[0] for entry in self._collect_entries(dialog_id, target, keep_ids)]

    def _collect_entries(self, dialog_id, target, keep_ids):
        """Пары (id поста, id канала-источника) — источник None для своих сообщений."""
        entries = []
        seen = set()
        offset_id = 0

        for page in range(MAX_PAGES):
            if self._stop:
                self._note("сбор прерван вручную")
                break

            response, error = self._request_retrying(
                self._search_page(dialog_id, target, offset_id)
            )
            if error is not None:
                raise RuntimeError("поиск не прошёл: %s" % _error_text(error))
            if response is None:
                break

            messages = _messages_of(response)
            if messages is None:
                self._note(
                    "страница не прочиталась, ответ %s" % _class_name(response)
                )
                break
            if not messages:
                break

            lowest = offset_id
            unreadable = 0
            for message in messages:
                message_id = _message_id(message)
                if message_id is None:
                    unreadable += 1
                    continue
                if lowest == 0 or message_id < lowest:
                    lowest = message_id
                if message_id in seen or message_id in keep_ids:
                    continue
                seen.add(message_id)
                entries.append((message_id, _source_channel(message)))

            if unreadable:
                self._note(
                    "не прочитал id у %d из %d постов страницы (%s)"
                    % (unreadable, len(messages), _class_name(messages[0]))
                )

            self._set_status("Собираю список: найдено %d" % len(entries))

            if len(messages) < PAGE_LIMIT:
                break
            if lowest <= 1 or (offset_id > 0 and lowest >= offset_id):
                break
            offset_id = lowest
            time.sleep(PAGE_PAUSE)

        entries.sort(key=lambda item: item[0])
        return entries

    # ------------------------------------------------------------------
    # Кто сколько постил
    # ------------------------------------------------------------------

    def _search_from_page(self, dialog_id, source_channel, offset_id):
        """Поиск с отправителем: сервер сам отдаёт только посты канала."""
        controller = get_messages_controller()
        request = TLRPC.TL_messages_search()
        request.peer = controller.getInputPeer(dialog_id)
        request.q = ""
        request.filter = TLRPC.TL_inputMessagesFilterEmpty()
        request.from_id = controller.getInputPeer(_normalize_dialog(source_channel))
        try:
            request.flags = int(getattr(request, "flags", 0)) | 1
        except Exception:
            request.flags = 1
        request.min_date = 0
        request.max_date = 0
        request.offset_id = offset_id
        request.add_offset = 0
        request.limit = PAGE_LIMIT
        request.max_id = 0
        request.min_id = 0
        for field in ("hash", "hash_"):
            try:
                setattr(request, field, 0)
            except Exception:
                pass
        return request

    def _history_page(self, dialog_id, offset_id):
        request = TLRPC.TL_messages_getHistory()
        request.peer = get_messages_controller().getInputPeer(dialog_id)
        request.offset_id = offset_id
        request.offset_date = 0
        request.add_offset = 0
        request.limit = PAGE_LIMIT
        request.max_id = 0
        request.min_id = 0
        for field in ("hash", "hash_"):
            try:
                setattr(request, field, 0)
            except Exception:
                pass
        return request

    def _collect_authors(self, dialog_id, keep_ids, page_builder=None):
        """Посты по авторам, содержимому и источникам пересылки.

        page_builder задаёт, что обходим: всю историю или только посты канала.
        """
        if page_builder is None:
            page_builder = lambda offset_id: self._history_page(dialog_id, offset_id)
        authors = {}
        kinds = {}
        sources = {}
        forwarded = set()
        seen = set()
        offset_id = 0
        total = 0

        for _ in range(MAX_PAGES):
            if self._stop:
                self._note("обход прерван вручную")
                break

            response, error = self._request_retrying(page_builder(offset_id))
            if error is not None:
                raise RuntimeError("история не прочиталась: %s" % _error_text(error))
            if response is None:
                break

            messages = _messages_of(response)
            if messages is None:
                self._note("страница истории не разобралась (%s)" % _class_name(response))
                break
            if not messages:
                break

            lowest = offset_id
            for message in messages:
                message_id = _message_id(message)
                if message_id is None:
                    continue
                if lowest == 0 or message_id < lowest:
                    lowest = message_id
                if message_id in seen:
                    continue
                seen.add(message_id)
                total += 1

                if message_id in keep_ids:
                    continue

                key = _author_key(message)
                bucket = authors.get(key)
                if bucket is None:
                    bucket = {"ids": [], "files": 0, "media": 0}
                    authors[key] = bucket
                bucket["ids"].append(message_id)
                if _has_document(message):
                    bucket["files"] += 1
                if _has_media(message):
                    bucket["media"] += 1

                kind = _content_kind(message)
                kinds.setdefault(kind, []).append(message_id)

                forward = _field(message, "fwd_from")
                if forward is not None:
                    forwarded.add(message_id)
                    origin = _source_channel(message)
                    if origin:
                        sources.setdefault(origin, []).append(message_id)

            self._set_status("Читаю историю: %d постов, авторов %d" % (total, len(authors)))

            if len(messages) < PAGE_LIMIT:
                break
            if lowest <= 1 or (offset_id > 0 and lowest >= offset_id):
                break
            offset_id = lowest
            time.sleep(PAGE_PAUSE)

        return authors, kinds, sources, forwarded, total

    def _author_title(self, key):
        kind, value = key
        if kind == "n":
            return str(value)
        if kind == "?":
            return "Без автора"

        controller = get_messages_controller()
        getter = "getUser" if kind == "u" else "getChat"
        entity = None
        try:
            entity = _call(controller, getter, [Long(int(value))])
        except Exception:
            entity = None

        parts = []
        if entity is not None:
            for name in ("first_name", "last_name", "title"):
                piece = _field(entity, name)
                if piece:
                    parts.append(str(piece))
            username = _field(entity, "username")
            if username:
                parts.append("@%s" % username)

        label = " ".join(parts) if parts else ("канал" if kind == "c" else "пользователь")
        return "%s · %s" % (label, value)

    def _on_authors_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Уже работаю, прогресс в настройках")
            return
        dialog_id = self._dialog_id(context)
        if not dialog_id:
            BulletinHelper.show_error("Не понял, какой это чат — откройте его")
            return
        self._busy = True
        self._stop = False
        threading.Thread(target=self._authors_job, args=(dialog_id,), daemon=True).start()

    def _authors_job(self, dialog_id):
        try:
            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))
            page_builder = None

            if self._is_broadcast(dialog_id) is False and self.get_setting(
                "group_channel_only", True
            ):
                page_builder, source = self._channel_pages(dialog_id)
                if page_builder is not None:
                    self._note(
                        "группа обсуждений: считаю только посты канала %s "
                        "(переключается в настройках)" % source
                    )

            self._note("чат %s, считаю авторов" % dialog_id)
            self._set_status("Читаю посты…")
            self._quiet_bulletin("Читаю посты, прогресс в настройках")

            authors, kinds, sources, _forwarded, total = self._collect_authors(
                dialog_id, keep_ids, page_builder
            )
            if not authors:
                self._busy = False
                self._set_status("Постов не нашлось")
                run_on_ui_thread(lambda: BulletinHelper.show_info("Постов не нашлось"))
                return

            ranked = sorted(authors.items(), key=lambda item: -len(item[1]["ids"]))
            self._note("всего постов %d, авторов %d" % (total, len(ranked)))

            rows = []
            for key, bucket in ranked[:40]:
                title = self._author_title(key)
                self._note(
                    "автор %s — постов %d, файлов %d, с вложением %d"
                    % (title, len(bucket["ids"]), bucket["files"], bucket["media"])
                )
                rows.append(("👤 " + title, bucket["ids"], bucket))

            if len(ranked) < 2:
                self._note(
                    "автор один: у постов нет подписи автора — она пишется в пост "
                    "только при включённых подписях и только с момента включения"
                )

            for kind in sorted(kinds, key=lambda k: -len(kinds[k])):
                self._note("тип «%s» — %d" % (kind, len(kinds[kind])))
                rows.append(("📦 %s" % kind, kinds[kind], None))

            for origin in sorted(sources, key=lambda k: -len(sources[k])):
                title = self._author_title(("c", origin))
                self._note("переслано из %s — %d" % (title, len(sources[origin])))
                rows.append(("↪️ Переслано: %s" % title, sources[origin], None))

            self._busy = False
            self._set_status("Постов %d, авторов %d" % (total, len(ranked)))
            run_on_ui_thread(lambda: self._show_authors(dialog_id, rows, total))
        except Exception as exception:
            message = str(exception)
            self._note("подсчёт авторов сорвался: %s" % message)
            self._set_status("Ошибка: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _show_authors(self, dialog_id, rows, total):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_info("Авторов: %d" % len(rows))
            return

        items = []
        for title, ids, bucket in rows:
            if bucket is not None:
                items.append("%s — %d постов (файлов %d)" % (title, len(ids), bucket["files"]))
            else:
                items.append("%s — %d постов" % (title, len(ids)))

        def on_pick(builder, index):
            builder.dismiss()
            if 0 <= index < len(rows):
                title, ids, bucket = rows[index]
                self._confirm_group(dialog_id, title, ids, bucket)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Постов всего: %d" % total)
        builder.set_items(items, on_pick)
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.set_neutral_button("Список в лог", lambda b, w: (b.dismiss(), self._copy_logs()))
        builder.create()
        builder.show()

    # ------------------------------------------------------------------
    # Замена файлов на картинку-заглушку
    # ------------------------------------------------------------------

    def _on_pick_placeholder(self, context=None):
        try:
            message = (context or {}).get("message")
        except Exception:
            message = None
        if message is None:
            BulletinHelper.show_error("Не понял, какое это сообщение")
            return

        message_id = _call(message, "getId")
        dialog_id = _call(message, "getDialogId")
        if message_id is None or dialog_id is None:
            BulletinHelper.show_error("Не смог прочитать сообщение")
            return

        photo = self._photo_of(message)
        document = self._document_of(message)

        # Держим готовые ссылки под рукой, чтобы не перезапрашивать их сразу же.
        if photo is not None:
            self._placeholder = self._media_from_photo(photo)
            self.set_setting("placeholder_chat", str(int(dialog_id)))
            self.set_setting("placeholder_msg", str(int(message_id)), reload_settings=True)
            self._note("заглушка-фото: чат %s, сообщение %s" % (dialog_id, message_id))
            BulletinHelper.show_success("Картинка запомнена как заглушка")
            return

        if document is not None:
            self._placeholder_doc = self._media_from_document(document)
            self.set_setting("placeholder_doc_chat", str(int(dialog_id)))
            self.set_setting("placeholder_doc_msg", str(int(message_id)), reload_settings=True)
            self._note("заглушка-файл: чат %s, сообщение %s" % (dialog_id, message_id))
            BulletinHelper.show_success("Файл запомнен — им заменю посты в альбомах")
            return

        self._note("в выбранном сообщении нет ни фото, ни файла")
        BulletinHelper.show_error("Тут нет картинки — выберите сообщение с ней")

    def _media_from_document(self, document):
        if document is None:
            return None
        input_document = TLRPC.TL_inputDocument()
        input_document.id = _field(document, "id")
        input_document.access_hash = _field(document, "access_hash")
        input_document.file_reference = _field(document, "file_reference")

        input_media = TLRPC.TL_inputMediaDocument()
        input_media.id = input_document
        return input_media

    def _document_of(self, message):
        owner = _field(message, "messageOwner")
        for holder in (owner, message):
            media = _field(holder, "media")
            document = _field(media, "document")
            if document is not None:
                return document
        return None

    def _media_from_photo(self, photo):
        if photo is None:
            return None
        input_photo = TLRPC.TL_inputPhoto()
        input_photo.id = _field(photo, "id")
        input_photo.access_hash = _field(photo, "access_hash")
        input_photo.file_reference = _field(photo, "file_reference")

        input_media = TLRPC.TL_inputMediaPhoto()
        input_media.id = input_photo
        return input_media

    def _photo_of(self, message):
        """TLRPC.Photo из сообщения, каким бы объектом оно ни было."""
        owner = _field(message, "messageOwner")
        for holder in (owner, message):
            media = _field(holder, "media")
            photo = _field(media, "photo")
            if photo is not None:
                return photo
        return None

    def _fetch_placeholder(self, as_document=False):
        """Свежая ссылка на заглушку: file_reference живёт недолго."""
        if as_document:
            chat_raw = self.get_setting("placeholder_doc_chat", "")
            message_raw = self.get_setting("placeholder_doc_msg", "")
            if not chat_raw or not message_raw:
                raise RuntimeError(
                    "заглушка-файл не выбрана: отправьте картинку файлом и пометьте её"
                )
        else:
            chat_raw = self.get_setting("placeholder_chat", "")
            message_raw = self.get_setting("placeholder_msg", "")
            if not chat_raw or not message_raw:
                raise RuntimeError(
                    "картинка не выбрана: зажмите сообщение с ней → «Заглушка для замены»"
                )

        # Идентификатор берётся как есть: у личных чатов он положительный.
        dialog_id = int(str(chat_raw).strip())
        message_id = int(str(message_raw).strip())

        # Сообщение достаём через историю: одна позиция сразу за нужной.
        request = self._history_page(dialog_id, message_id + 1)
        request.limit = 1
        response, error = self._request_retrying(request)
        if error is not None:
            raise RuntimeError("картинку не достать: %s" % _error_text(error))

        messages = _messages_of(response) or []
        picked = None
        for message in messages:
            if _message_id(message) == message_id:
                picked = message
                break
        if picked is None and messages:
            picked = messages[0]
        if picked is None:
            raise RuntimeError("сообщение с картинкой не найдено — выберите заново")

        if as_document:
            media = self._media_from_document(self._document_of(picked))
            if media is None:
                raise RuntimeError("в помеченном сообщении нет файла")
        else:
            media = self._media_from_photo(self._photo_of(picked))
            if media is None:
                raise RuntimeError("в выбранном сообщении нет фото")
        return media

    def _edit_request(self, dialog_id, message, input_media):
        """Меняем медиа, подпись и её разметку оставляем как были."""
        request = TLRPC.TL_messages_editMessage()
        request.peer = get_messages_controller().getInputPeer(dialog_id)
        request.id = int(_message_id(message))
        request.media = input_media

        flags = EDIT_FLAG_MEDIA
        caption = _field(message, "message")
        request.message = str(caption) if caption else ""
        flags |= EDIT_FLAG_MESSAGE

        entities = _as_list(_field(message, "entities")) or []
        if entities:
            holder = ArrayList()
            for entity in entities:
                holder.add(entity)
            request.entities = holder
            flags |= EDIT_FLAG_ENTITIES

        request.flags = flags
        return request, len(entities)

    def _collect_documents(self, dialog_id, target, keep_ids):
        """Посты с вложениями вместе с самими объектами — нужна подпись."""
        items = []
        seen = set()
        offset_id = 0

        for _ in range(MAX_PAGES):
            if self._stop:
                self._note("сбор прерван вручную")
                break

            response, error = self._request_retrying(
                self._search_page(dialog_id, target, offset_id)
            )
            if error is not None:
                raise RuntimeError("поиск не прошёл: %s" % _error_text(error))
            if response is None:
                break

            messages = _messages_of(response)
            if messages is None:
                self._note("страница не прочиталась (%s)" % _class_name(response))
                break
            if not messages:
                break

            lowest = offset_id
            for message in messages:
                message_id = _message_id(message)
                if message_id is None:
                    continue
                if lowest == 0 or message_id < lowest:
                    lowest = message_id
                if message_id in seen or message_id in keep_ids:
                    continue
                seen.add(message_id)
                items.append(message)

            self._set_status("Собираю список: найдено %d" % len(items))

            if len(messages) < PAGE_LIMIT:
                break
            if lowest <= 1 or (offset_id > 0 and lowest >= offset_id):
                break
            offset_id = lowest
            time.sleep(PAGE_PAUSE)

        items.sort(key=lambda item: _message_id(item) or 0)
        return items

    def _on_replace_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Уже работаю, прогресс в настройках")
            return
        dialog_id = self._dialog_id(context)
        if not dialog_id:
            BulletinHelper.show_error("Не понял, какой это канал — откройте его")
            return
        self._busy = True
        self._stop = False
        threading.Thread(target=self._replace_job, args=(dialog_id,), daemon=True).start()

    def _replace_job(self, dialog_id):
        try:
            target = int(self.get_setting("target", TARGET_FILES) or 0)
            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))

            self._set_status("Проверяю картинку…")
            input_media = self._placeholder
            if input_media is None:
                input_media = self._fetch_placeholder()
                self._note("картинка-заглушка получена из чата")
            else:
                self._note("использую картинку, выбранную в этой сессии")

            if self._placeholder_doc is None and self.get_setting("placeholder_doc_msg", ""):
                try:
                    self._placeholder_doc = self._fetch_placeholder(True)
                    self._note("заглушка-файл для альбомов получена")
                except Exception as doc_error:
                    self._note("заглушку-файл достать не вышло: %s" % doc_error)

            self._set_status("Собираю посты…")
            self._quiet_bulletin("Ищу посты с файлами, прогресс в настройках")
            dialog_id, _ = self._resolve_dialog(dialog_id, target)
            items = self._collect_documents(dialog_id, target, keep_ids)
            self._note("постов с вложениями: %d" % len(items))

            if not items:
                self._busy = False
                self._set_status("Заменять нечего")
                run_on_ui_thread(lambda: BulletinHelper.show_info("Таких постов нет"))
                return

            with_caption = sum(1 for item in items if _field(item, "message"))
            self._busy = False
            self._set_status("Найдено %d — жду подтверждения" % len(items))
            run_on_ui_thread(
                lambda: self._confirm_replace(dialog_id, items, input_media, with_caption)
            )
        except Exception as exception:
            message = str(exception)
            self._note("замена сорвалась: %s" % message)
            self._set_status("Ошибка: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _confirm_replace(self, dialog_id, items, input_media, with_caption):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            self._set_status("Некуда показать подтверждение")
            return

        minutes = int(len(items) * EDIT_PAUSE / 60) + 1
        builder = AlertDialogBuilder(activity)
        builder.set_title("Заменить файлы в %d постах?" % len(items))
        builder.set_message(
            "Файл в каждом посте заменится на выбранную картинку.\n\n"
            "Подпись сохраняется как есть: премиум-эмодзи, ссылки, скрытые ссылки "
            "в тексте и всё остальное форматирование.\n\n"
            "Постов с подписью: %d из %d\n"
            "Займёт примерно %d мин — Telegram ограничивает частоту правок.\n\n"
            "Сами файлы после замены из постов исчезнут."
            % (with_caption, len(items), minutes)
        )
        builder.set_positive_button(
            "Заменить в фоне",
            lambda b, w: (b.dismiss(), self._start_replace(dialog_id, items, input_media)),
        )
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.create()
        builder.show()

    def _start_replace(self, dialog_id, items, input_media):
        self._busy = True
        self._stop = False
        self._quiet_bulletin("Меняю файлы на картинку — прогресс в настройках")
        threading.Thread(
            target=self._replace_worker,
            args=(dialog_id, items, input_media),
            daemon=True,
        ).start()

    def _try_edit(self, dialog_id, message, media):
        """Одна попытка правки. Возвращает (успех, текст ошибки, число сущностей)."""
        request, entity_count = self._edit_request(dialog_id, message, media)
        try:
            response, error = self._request_retrying(request, timeout=EDIT_TIMEOUT)
        except Exception as exception:
            return False, str(exception), entity_count
        if error is None:
            return True, None, entity_count
        return False, _error_text(error), entity_count

    def _replace_worker(self, dialog_id, items, input_media):
        done = 0
        failed = []
        reasons = {}
        albums = 0
        total = len(items)

        for index, message in enumerate(items):
            if self._stop:
                self._note("замена остановлена на %d из %d" % (done, total))
                break

            message_id = _message_id(message)
            grouped = _field(message, "grouped_id")

            # В альбоме фото вместо файла ломает группу — там сразу пробуем файл.
            order = []
            if grouped and self._placeholder_doc is not None:
                albums += 1
                order = [(self._placeholder_doc, "файл"), (input_media, "фото")]
            else:
                order = [(input_media, "фото"), (self._placeholder_doc, "файл")]

            success = False
            last_error = None
            try:
                for media, label in order:
                    if media is None:
                        continue
                    success, last_error, entity_count = self._try_edit(
                        dialog_id, message, media
                    )
                    if success:
                        done += 1
                        if done == 1:
                            self._note(
                                "первый пост заменён (%s), разметки в подписи: %d"
                                % (label, entity_count)
                            )
                        break

                    if "FILE_REFERENCE" in (last_error or ""):
                        try:
                            refreshed = self._fetch_placeholder(label == "файл")
                            if label == "файл":
                                self._placeholder_doc = refreshed
                            else:
                                input_media = refreshed
                                self._placeholder = refreshed
                            self._note("обновил ссылку на заглушку, повторяю")
                            success, last_error, entity_count = self._try_edit(
                                dialog_id, message, refreshed
                            )
                            if success:
                                done += 1
                                break
                        except Exception as refresh_error:
                            self._note("заглушку обновить не вышло: %s" % refresh_error)

                if not success:
                    failed.append(message_id)
                    code = (last_error or "неизвестно").split("_")[0:3]
                    key = "_".join(code) if code else "неизвестно"
                    reasons[key] = reasons.get(key, 0) + 1
                    self._note(
                        "пост #%s не заменён: %s%s"
                        % (message_id, last_error, " (альбом)" if grouped else "")
                    )
            except Exception as exception:
                failed.append(message_id)
                self._note("пост #%s сорвался: %s" % (message_id, exception))

            self._set_status(
                "Заменено %d из %d · осталось %d · ошибок %d"
                % (done, total, total - done - len(failed), len(failed))
            )
            if index + 1 < total:
                time.sleep(EDIT_PAUSE)

        if albums:
            self._note("постов в альбомах: %d" % albums)
        for key in sorted(reasons, key=lambda k: -reasons[k]):
            self._note("причина «%s» — %d постов" % (key, reasons[key]))
        if reasons and self._placeholder_doc is None:
            self._note(
                "для постов в альбомах нужна заглушка-файл: отправьте ту же картинку "
                "файлом (без сжатия) и пометьте её «Заглушка для замены»"
            )

        self._busy = False
        self._note("замена завершена: %d из %d, ошибок %d" % (done, total, len(failed)))
        self._set_status(
            "Готово: заменено %d из %d%s"
            % (done, total, (", ошибок %d" % len(failed)) if failed else "")
        )

        def notify():
            if failed:
                BulletinHelper.show_error("Заменено %d, не вышло %d" % (done, len(failed)))
            else:
                BulletinHelper.show_success("Заменено постов: %d" % done)

        run_on_ui_thread(notify)

    # ------------------------------------------------------------------
    # Оставить только избранных авторов
    # ------------------------------------------------------------------

    def _channel_pages(self, dialog_id):
        """Обходчик только постов канала — для групп обсуждений.

        Возвращает (page_builder, id канала) или (None, None), если канал неизвестен.
        """
        wanted = _normalize_dialog(self.get_setting("source_channel", ""))
        source = abs(wanted) if wanted else None
        if not source:
            try:
                source = self._linked_channel(dialog_id)
            except Exception as error:
                self._note("привязку чата определить не вышло: %s" % error)
                source = None
        if not source:
            return None, None

        def builder(offset_id, channel=source):
            return self._search_from_page(dialog_id, channel, offset_id)

        return builder, source

    def _is_broadcast(self, dialog_id):
        """True — канал, False — группа обсуждений, None — не понял."""
        try:
            chat = _call(get_messages_controller(), "getChat", [Long(abs(int(dialog_id)))])
        except Exception:
            chat = None
        if chat is None:
            return None
        if _field(chat, "broadcast"):
            return True
        if _field(chat, "megagroup"):
            return False
        return None

    def _on_cleanup_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Уже работаю, прогресс в настройках")
            return
        dialog_id = self._dialog_id(context)
        if not dialog_id:
            BulletinHelper.show_error("Не понял, какой это чат — откройте его")
            return
        self._busy = True
        self._stop = False
        threading.Thread(target=self._cleanup_job, args=(dialog_id,), daemon=True).start()

    def _cleanup_job(self, dialog_id):
        try:
            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))
            keep_names = _parse_names(
                self.get_setting("keep_authors", KEEP_AUTHORS_DEFAULT)
            )
            if not keep_names:
                raise RuntimeError("не задано ни одного автора, которого оставлять")

            broadcast = self._is_broadcast(dialog_id)
            only_forwarded = broadcast is False
            page_builder = None

            if only_forwarded:
                # В обсуждении миллион сообщений участников — их читать незачем.
                page_builder, source = self._channel_pages(dialog_id)
                if page_builder is None:
                    raise RuntimeError(
                        "не понял, какой канал привязан — впишите его в «Канал-источник»"
                    )
                self._note("группа обсуждений: беру только посты канала %s" % source)

            self._note(
                "чат %s, оставляю авторов: %s" % (dialog_id, ", ".join(keep_names))
            )
            self._set_status("Читаю посты…")
            self._quiet_bulletin("Читаю посты, прогресс в настройках")

            authors, _kinds, _sources, forwarded, total = self._collect_authors(
                dialog_id, keep_ids, page_builder
            )
            if not authors:
                self._busy = False
                self._set_status("Постов не нашлось")
                run_on_ui_thread(lambda: BulletinHelper.show_info("Постов не нашлось"))
                return

            kept_titles = []
            doomed_titles = []
            victims = []

            for key, bucket in sorted(authors.items(), key=lambda item: -len(item[1]["ids"])):
                title = self._author_title(key)
                ids = bucket["ids"]
                if only_forwarded and page_builder is None:
                    # Поиск по отправителю уже отсеял чужое, фильтр нужен только при обходе истории.
                    ids = [value for value in ids if value in forwarded]
                if not ids:
                    continue
                if _name_matches(title, keep_names):
                    kept_titles.append("%s (%d)" % (title, len(ids)))
                else:
                    doomed_titles.append("%s (%d)" % (title, len(ids)))
                    victims.extend(ids)

            self._note("оставляю: %s" % ("; ".join(kept_titles) or "никого"))
            self._note("под удаление: %s" % ("; ".join(doomed_titles) or "никого"))

            if not kept_titles:
                raise RuntimeError(
                    "ни один автор не совпал со списком — проверьте написание имён"
                )

            if not victims:
                self._busy = False
                self._set_status("Удалять нечего: все авторы в списке")
                run_on_ui_thread(
                    lambda: BulletinHelper.show_info("Все авторы в списке, удалять нечего")
                )
                return

            victims = sorted(set(victims))
            self._busy = False
            self._set_status("К удалению %d из %d — жду подтверждения" % (len(victims), total))
            run_on_ui_thread(
                lambda: self._confirm_cleanup(
                    dialog_id, victims, kept_titles, doomed_titles, total, only_forwarded
                )
            )
        except Exception as exception:
            message = str(exception)
            self._note("чистка по авторам сорвалась: %s" % message)
            self._set_status("Ошибка: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _confirm_cleanup(self, dialog_id, ids, kept, doomed, total, only_forwarded):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            self._set_status("Некуда показать подтверждение")
            return

        shown = doomed[:10]
        if len(doomed) > 10:
            shown.append("…и ещё %d авторов" % (len(doomed) - 10))

        lines = [
            "Оставляю (%d):" % len(kept),
            "\n".join("• " + item for item in kept),
            "",
            "Удаляю у %d авторов, всего %d постов из %d:" % (len(doomed), len(ids), total),
            "\n".join("• " + item for item in shown),
        ]
        if only_forwarded:
            lines.append("")
            lines.append("Это группа обсуждений — трогаю только пересланное из канала.")
        lines.append("")
        lines.append("Удаляются все посты этих авторов, не только с файлами. Необратимо.")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалить %d постов?" % len(ids))
        builder.set_message("\n".join(lines))
        builder.set_positive_button(
            "Удалить в фоне",
            lambda b, w: (b.dismiss(), self._start_delete(dialog_id, ids)),
        )
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.create()
        builder.show()
        try:
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass

    def _confirm_group(self, dialog_id, title, group_ids, bucket=None):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            return

        ids = sorted(group_ids)
        preview = ", ".join("#%d" % value for value in ids[:12])
        if len(ids) > 12:
            preview += " …"

        details = "Всего постов: %d" % len(ids)
        if bucket is not None:
            details += "\nИз них с файлами: %d, с любым вложением: %d" % (
                bucket["files"],
                bucket["media"],
            )

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалить %d постов?" % len(ids))
        builder.set_message(
            "%s\n\n%s\n\n%s\n\nУдаляется вся группа целиком. Необратимо."
            % (title, details, preview)
        )
        builder.set_positive_button(
            "Удалить в фоне",
            lambda b, w: (b.dismiss(), self._start_delete(dialog_id, ids)),
        )
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.create()
        builder.show()
        try:
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass

    # ------------------------------------------------------------------
    # Репосты канала в чате обсуждений
    # ------------------------------------------------------------------

    def _linked_channel(self, dialog_id):
        """Канал, привязанный к этой группе обсуждений."""
        controller = get_messages_controller()
        chat_id = abs(int(dialog_id))

        variants = [[Long(chat_id)]]
        if chat_id <= 2147483647:
            # id крупных чатов в int уже не помещается — такой вызов даже не строим.
            try:
                variants.append([Integer(chat_id)])
            except Exception:
                pass

        for arguments in variants:
            try:
                full = _call(controller, "getChatFull", arguments)
            except Exception:
                continue
            if full is None:
                continue
            value = _field(full, "linked_chat_id")
            try:
                number = abs(int(value))
            except Exception:
                number = 0
            if number:
                return number
        return None

    def _on_forwarded_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Уже работаю, прогресс в настройках")
            return
        dialog_id = self._dialog_id(context)
        if not dialog_id:
            BulletinHelper.show_error("Не понял, какой это чат — откройте его")
            return
        self._busy = True
        self._stop = False
        threading.Thread(
            target=self._forwarded_job, args=(dialog_id,), daemon=True
        ).start()

    def _forwarded_job(self, dialog_id):
        try:
            target = int(self.get_setting("target", TARGET_FILES) or 0)
            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))

            self._note("чат %s, ищу репосты канала" % dialog_id)
            self._set_status("Собираю список…")
            self._quiet_bulletin("Ищу репосты канала, прогресс в настройках")

            dialog_id, _ = self._resolve_dialog(dialog_id, target)
            entries = self._collect_entries(dialog_id, target, keep_ids)
            self._note("всего постов с вложениями в чате: %d" % len(entries))

            counts = {}
            for _, channel_id in entries:
                if channel_id:
                    counts[channel_id] = counts.get(channel_id, 0) + 1
            if counts:
                self._note(
                    "источники в чате: %s"
                    % ", ".join(
                        "%s×%d" % (key, counts[key])
                        for key in sorted(counts, key=lambda k: -counts[k])[:6]
                    )
                )
            else:
                self._note("ни у одного поста не нашлось признаков пересылки")

            wanted = _normalize_dialog(self.get_setting("source_channel", ""))
            source = abs(wanted) if wanted else None
            if source:
                self._note("канал-источник задан вручную: %s" % source)
            else:
                try:
                    source = self._linked_channel(dialog_id)
                except Exception as link_error:
                    source = None
                    self._note("привязку чата определить не вышло: %s" % link_error)
                if source:
                    self._note("канал-источник по привязке чата: %s" % source)

            if source and source not in counts:
                self._note(
                    "постов от канала %s в выборке нет — беру источник по содержимому"
                    % source
                )
                source = None

            if not source and counts:
                source = max(counts, key=lambda key: counts[key])
                self._note("источник определён по содержимому чата: %s" % source)

            if not source:
                raise RuntimeError("не нашёл, из какого канала эти посты")

            ids = [value for value, channel_id in entries if channel_id == source]
            own = len(entries) - len(ids)
            self._note("из канала %s: %d, чужих оставляю: %d" % (source, len(ids), own))

            if not ids:
                self._busy = False
                self._set_status("Репостов канала не нашлось")
                run_on_ui_thread(
                    lambda: BulletinHelper.show_info(
                        "Постов из канала здесь нет (всего с файлами: %d)" % len(entries)
                    )
                )
                return

            self._set_status("Найдено %d репостов — жду подтверждения" % len(ids))
            run_on_ui_thread(
                lambda: self._confirm_forwarded(dialog_id, ids, source, own, keep_ids)
            )
        except Exception as exception:
            message = str(exception)
            self._note("поиск репостов сорвался: %s" % message)
            self._set_status("Ошибка: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _confirm_forwarded(self, dialog_id, ids, source, own, keep_ids):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            self._busy = False
            self._set_status("Некуда показать подтверждение")
            return

        preview = ", ".join("#%d" % value for value in ids[:12])
        if len(ids) > 12:
            preview += " …"

        lines = [
            "Репостов из канала %s: %d" % (source, len(ids)),
            "Чужих постов с вложениями не трону: %d" % own,
            "",
            preview,
        ]
        if keep_ids:
            lines.append("")
            lines.append("Не трогаю также: %s" % ", ".join("#%d" % v for v in sorted(keep_ids)))
        lines.append("")
        lines.append("Удаление необратимо.")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалить %d репостов?" % len(ids))
        builder.set_message("\n".join(lines))
        builder.set_positive_button(
            "Удалить в фоне",
            lambda b, w: (b.dismiss(), self._start_delete(dialog_id, ids)),
        )
        builder.set_negative_button("Отмена", lambda b, w: (b.dismiss(), self._cancel()))
        builder.create()
        builder.show()
        try:
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass

    # ------------------------------------------------------------------
    # Удаление
    # ------------------------------------------------------------------

    def _delete_via_controller(self, dialog_id, chunk, cache_only=False):
        """Удаление руками клиента — он же чистит локальную базу и вкладки."""
        controller = get_messages_controller()
        id_list = ArrayList()
        for message_id in chunk:
            id_list.add(Integer(int(message_id)))

        for method in _find_methods(controller, "deleteMessages"):
            try:
                arguments = _delete_args(
                    method.getParameterTypes(), id_list, dialog_id, cache_only
                )
            except Exception:
                continue
            if arguments is None:
                continue
            try:
                _invoke(method, controller, arguments)
                return True
            except Exception:
                continue
        return False

    def _delete_via_api(self, dialog_id, chunk):
        peer = get_messages_controller().getInputPeer(dialog_id)
        if isinstance(peer, TLRPC.TL_inputPeerChannel):
            request = TLRPC.TL_channels_deleteMessages()
            channel = TLRPC.TL_inputChannel()
            channel.channel_id = peer.channel_id
            channel.access_hash = peer.access_hash
            request.channel = channel
        else:
            request = TLRPC.TL_messages_deleteMessages()
            request.revoke = True
        for message_id in chunk:
            request.id.add(Integer(int(message_id)))

        response, error = self._request_retrying(request)
        if error is not None:
            raise RuntimeError(_error_text(error))
        return True

    def _on_delete_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Уже работаю, прогресс в настройках")
            return

        dialog_id = self._dialog_id(context)
        if not dialog_id:
            BulletinHelper.show_error("Не понял, какой это канал — откройте его")
            return
        if dialog_id >= 0:
            BulletinHelper.show_error("Работаю только с каналами и группами")
            return

        self._busy = True
        self._stop = False
        threading.Thread(
            target=self._prepare_job, args=(dialog_id,), daemon=True
        ).start()

    def _prepare_job(self, dialog_id):
        try:
            target = int(self.get_setting("target", TARGET_FILES) or 0)
            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))

            self._note("канал %s, ищу %s" % (dialog_id, TARGET_NAMES.get(target, "файлы")))
            self._set_status("Собираю список…")
            self._quiet_bulletin("Собираю список, прогресс в настройках плагина")

            dialog_id, probe = self._resolve_dialog(dialog_id, target)
            server_total = getattr(probe, "count", None)
            self._note("рабочий id %s, на сервере таких постов: %s" % (dialog_id, server_total))

            ids = self._collect_ids(dialog_id, target, keep_ids)
            self._note("найдено %d постов" % len(ids))

            if not ids:
                self._busy = False
                self._set_status("На сервере таких постов нет")
                run_on_ui_thread(lambda: self._offer_repair(dialog_id, target))
                return

            self._set_status("Найдено %d — жду подтверждения" % len(ids))
            run_on_ui_thread(lambda: self._confirm(dialog_id, ids, keep_ids))
        except Exception as exception:
            message = str(exception)
            self._note("сбор сорвался: %s" % message)
            self._set_status("Ошибка: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _confirm(self, dialog_id, ids, keep_ids):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            self._busy = False
            self._set_status("Некуда показать подтверждение")
            return

        preview = ", ".join("#%d" % value for value in ids[:12])
        if len(ids) > 12:
            preview += " …"

        lines = [
            "Постов к удалению: %d" % len(ids),
            "Пачками по %d, в фоне." % DELETE_CHUNK,
            "",
            preview,
        ]
        if keep_ids:
            lines.append("")
            lines.append("Не трогаю: %s" % ", ".join("#%d" % v for v in sorted(keep_ids)))
        lines.append("")
        lines.append("Удаление в канале необратимо.")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалить %d постов?" % len(ids))
        builder.set_message("\n".join(lines))
        builder.set_positive_button(
            "Удалить в фоне",
            lambda b, w: (b.dismiss(), self._start_delete(dialog_id, ids)),
        )
        builder.set_negative_button("Отмена", lambda b, w: (b.dismiss(), self._cancel()))
        builder.create()
        builder.show()
        try:
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass

    def _cancel(self):
        self._busy = False
        self._set_status("Отменено")

    # ------------------------------------------------------------------
    # Призраки во вкладке: локальный кэш пережил удаление
    # ------------------------------------------------------------------

    def _offer_repair(self, dialog_id, target):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_info("Удалять нечего — на сервере таких постов нет")
            return

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалять нечего")
        builder.set_message(
            "На сервере постов такого типа не осталось.\n\n"
            "Если вкладка всё ещё показывает файлы — это устаревший локальный кэш "
            "клиента. Могу вычистить из него записи о постах, которых на сервере нет: "
            "сами посты уже удалены, трогаться будет только кэш."
        )
        builder.set_positive_button(
            "Почистить кэш вкладки",
            lambda b, w: (b.dismiss(), self._start_repair(dialog_id, target)),
        )
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.create()
        builder.show()

    def _repair_click(self, view=None):
        if self._busy:
            BulletinHelper.show_info("Подождите, идёт другая операция")
            return
        dialog_id = self._dialog_id({})
        if not dialog_id:
            BulletinHelper.show_error("Откройте канал, кэш которого чиним")
            return
        target = int(self.get_setting("target", TARGET_FILES) or 0)
        self._start_repair(dialog_id, target)

    def _start_repair(self, dialog_id, target):
        self._busy = True
        self._stop = False
        self._quiet_bulletin("Чищу кэш вкладки")
        threading.Thread(
            target=self._repair_worker, args=(dialog_id, target), daemon=True
        ).start()

    def _cached_ids(self):
        """Что показывает вкладка прямо сейчас."""
        layout = self._layout()
        if layout is None:
            raise RuntimeError("откройте профиль канала и вкладку с медиа")
        tab = self._tab(layout)
        ids = []
        for message in self._messages(layout, tab):
            value = _call(message, "getId")
            try:
                ids.append(int(value))
            except Exception:
                continue
        return ids

    def _repair_worker(self, dialog_id, target):
        try:
            self._set_status("Читаю, что показывает вкладка…")
            cached = self._cached_ids()
            self._note("во вкладке показано %d элементов" % len(cached))

            if not cached:
                self._busy = False
                self._set_status("Вкладка пуста — чистить нечего")
                run_on_ui_thread(lambda: BulletinHelper.show_info("Вкладка и так пуста"))
                return

            self._set_status("Сверяю с сервером…")
            _, probe = self._resolve_dialog(dialog_id, target)
            server_total = getattr(probe, "count", None) or 0
            alive = set(self._collect_ids(dialog_id, target, set()))
            self._note("сервер насчитал %s, собрано %d" % (server_total, len(alive)))

            if server_total and not alive:
                # Сервер знает о постах, а список не собрался — чистить нельзя.
                self._busy = False
                self._set_status(
                    "Сервер сообщает о %d постах, но список не читается — кэш не трогаю"
                    % server_total
                )
                self._note("чистка отменена: расхождение сервера и разбора ответа")
                run_on_ui_thread(
                    lambda: BulletinHelper.show_error(
                        "Список не читается — кэш не трогаю, смотрите лог"
                    )
                )
                return

            ghosts = [value for value in cached if value not in alive]
            self._note("на сервере живых %d, призраков %d" % (len(alive), len(ghosts)))

            if not ghosts:
                self._busy = False
                self._set_status("Призраков нет, вкладка совпадает с сервером")
                run_on_ui_thread(
                    lambda: BulletinHelper.show_info("Кэш совпадает с сервером")
                )
                return

            cleaned = 0
            for start in range(0, len(ghosts), DELETE_CHUNK):
                chunk = ghosts[start : start + DELETE_CHUNK]
                if self._delete_via_controller(dialog_id, chunk, cache_only=True):
                    cleaned += len(chunk)
                else:
                    self._note("пачку кэша вычистить не вышло")
                self._set_status("Чищу кэш: %d из %d" % (cleaned, len(ghosts)))
                time.sleep(0.2)

            self._busy = False
            self._note("кэш вычищен: %d записей" % cleaned)
            self._set_status("Кэш вычищен: %d записей" % cleaned)
            run_on_ui_thread(
                lambda: BulletinHelper.show_success(
                    "Убрано из кэша: %d. Перезайдите во вкладку" % cleaned
                )
            )
        except Exception as exception:
            message = str(exception)
            self._note("чистка кэша сорвалась: %s" % message)
            self._set_status("Ошибка чистки кэша: %s" % message)
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _start_delete(self, dialog_id, ids):
        self._busy = True
        self._stop = False
        self._quiet_bulletin("Удаляю в фоне — прогресс в настройках плагина")
        threading.Thread(
            target=self._delete_worker, args=(dialog_id, ids), daemon=True
        ).start()

    def _delete_worker(self, dialog_id, ids):
        deleted = 0
        failed = []
        total = len(ids)
        started = time.time()

        try:
            for start in range(0, total, DELETE_CHUNK):
                if self._stop:
                    self._note("остановлено вручную на %d из %d" % (deleted, total))
                    break

                chunk = ids[start : start + DELETE_CHUNK]
                if self._delete_via_controller(dialog_id, chunk):
                    deleted += len(chunk)
                else:
                    try:
                        self._delete_via_api(dialog_id, chunk)
                        deleted += len(chunk)
                        self._note("пачка ушла напрямую через API")
                    except Exception as chunk_error:
                        failed.extend(chunk)
                        self._note("пачка не удалилась: %s" % chunk_error)

                done = deleted + len(failed)
                self._set_status(
                    "Удалено %d из %d · осталось %d · ошибок %d"
                    % (deleted, total, total - done, len(failed))
                )
                if start + DELETE_CHUNK < total:
                    time.sleep(CHUNK_PAUSE)
        except Exception as exception:
            self._note("удаление сорвалось: %s" % traceback.format_exc().splitlines()[-1])
            self._set_status("Сбой на %d из %d: %s" % (deleted, total, exception))
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Сбой удаления"))
            return

        spent = int(time.time() - started)
        self._busy = False
        self._note("готово: удалено %d, ошибок %d, за %d с" % (deleted, len(failed), spent))
        if failed:
            self._note("не удалились: %s" % ", ".join("#%d" % v for v in failed[:100]))

        self._set_status(
            "Готово: удалено %d из %d%s"
            % (deleted, total, (", ошибок %d" % len(failed)) if failed else "")
        )

        def notify():
            if failed:
                BulletinHelper.show_error("Удалено %d, не вышло %d" % (deleted, len(failed)))
            else:
                BulletinHelper.show_success("Удалено постов: %d" % deleted)

        run_on_ui_thread(notify)

    def _quiet_bulletin(self, text):
        if self.get_setting("silent", False):
            return
        run_on_ui_thread(lambda: BulletinHelper.show_info(text))

    # ------------------------------------------------------------------
    # Ручное выделение (запасной путь)
    # ------------------------------------------------------------------

    def _tab(self, layout):
        for method_name in ("getSelectedTab", "getClosestTab"):
            method = _find_method(layout, method_name, 0)
            if method is None:
                continue
            try:
                return int(_invoke(method, layout, []))
            except Exception:
                continue
        value = get_private_field(layout, "selectedTab")
        try:
            return int(value)
        except Exception:
            return 1

    def _messages(self, layout, tab):
        _, data = _first_field(layout, ("sharedMediaData",))
        if data is None:
            raise RuntimeError("не нашёл список медиа")
        bucket = _array_get(data, tab)
        if bucket is None:
            raise RuntimeError("вкладка ещё не загружена")
        messages = None
        for field in ("messages", "messagesList"):
            try:
                messages = get_private_field(bucket, field)
            except Exception:
                messages = None
            if messages is not None:
                break
        items = _as_list(messages)
        if items is None:
            raise RuntimeError("список сообщений не читается")
        return items

    def _selected_count(self, layout):
        selected = get_private_field(layout, "selectedFiles")
        if selected is None:
            return 0
        total = 0
        for index in (0, 1):
            bucket = _array_get(selected, index)
            if bucket is None:
                continue
            size_method = _find_method(bucket, "size", 0)
            if size_method is None:
                continue
            try:
                total += int(_invoke(size_method, bucket, []))
            except Exception:
                continue
        return total

    def _on_select_click(self, context=None):
        def work():
            try:
                layout = self._layout()
                if layout is None:
                    raise RuntimeError("откройте профиль канала и вкладку с медиа")
                tab = self._tab(layout)
                messages = self._messages(layout, tab)
                if not messages:
                    raise RuntimeError("на вкладке ничего не загружено")
                run_on_ui_thread(lambda: self._select(layout, tab, messages))
            except Exception as exception:
                message = str(exception)
                run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

        threading.Thread(target=work, daemon=True).start()

    def _select(self, layout, tab, messages):
        try:
            long_click = _find_method(layout, "onItemLongClick", 3)
            item_click = _find_method(layout, "onItemClick", 5)
            if long_click is None or item_click is None:
                raise RuntimeError("клиент не даёт добраться до выделения")

            _invoke(long_click, layout, [messages[0], None, Integer(int(tab))])
            for index in range(1, min(len(messages), DELETE_CHUNK)):
                try:
                    _invoke(
                        item_click,
                        layout,
                        [
                            Integer(int(index)),
                            None,
                            messages[index],
                            Integer(int(tab)),
                            Integer(int(tab)),
                        ],
                    )
                except Exception:
                    continue

            marked = self._selected_count(layout)
            BulletinHelper.show_success(
                "Отмечено %d на вкладке «%s»" % (marked, TAB_NAMES.get(tab, tab))
            )
        except Exception as exception:
            log("[files_cleaner] выделение:\n" + traceback.format_exc())
            BulletinHelper.show_error("Не вышло: %s" % exception)
