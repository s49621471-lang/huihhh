# ---------------------------------------------------------------------------
# Утилиты
# ---------------------------------------------------------------------------


def _parse_ids(raw):
    """'44', '44, 45' и ссылки t.me/c/.../44 — всё в набор номеров."""
    result = set()
    if not raw:
        return result
    for token in re.split(r"[\s,;]+", str(raw)):
        numbers = re.findall(r"\d+", token or "")
        if not numbers:
            continue
        try:
            result.add(int(numbers[-1]))
        except Exception:
            continue
    return result


def _normalize_dialog(value):
    """Внутри клиента канал — это -channel_id, без префикса 100 из ссылок."""
    try:
        number = int(value)
    except Exception:
        return None
    if number == 0:
        return None
    if number > 0:
        number = -number
    text = str(abs(number))
    if len(text) > 12 and text.startswith("100"):
        try:
            number = -int(text[3:])
        except Exception:
            pass
    return number


def _bot_api_dialog(value):
    """Тот же чат в записи -100…, на случай если клиент ждёт именно её."""
    try:
        number = abs(int(value))
    except Exception:
        return None
    text = str(number)
    if len(text) > 12 and text.startswith("100"):
        return -number
    return -(1000000000000 + number)


def _error_text(error):
    if error is None:
        return "неизвестная ошибка"
    try:
        return getattr(error, "text", None) or str(error)
    except Exception:
        return "неизвестная ошибка"


def _flood_wait(error):
    match = re.search(r"FLOOD_WAIT_(\d+)", _error_text(error) or "")
    return int(match.group(1)) if match else 0


def _filter_for_target(target):
    if target == TARGET_MEDIA:
        return TLRPC.TL_inputMessagesFilterPhotoVideo()
    if target == TARGET_MUSIC:
        return TLRPC.TL_inputMessagesFilterMusic()
    if target == TARGET_VOICE:
        return TLRPC.TL_inputMessagesFilterVoice()
    if target == TARGET_GIF:
        return TLRPC.TL_inputMessagesFilterGif()
    return TLRPC.TL_inputMessagesFilterDocument()


TARGET_NAMES = {
    TARGET_FILES: "файлы",
    TARGET_MEDIA: "фото и видео",
    TARGET_MUSIC: "музыку",
    TARGET_VOICE: "голосовые",
    TARGET_GIF: "GIF",
}


def _find_methods(java_object, name):
    """Все методы с таким именем, от простых сигнатур к сложным."""
    found = []
    try:
        clazz = java_object.getClass()
    except Exception:
        return found

    while clazz is not None:
        try:
            methods = clazz.getDeclaredMethods()
        except Exception:
            methods = []
        for method in methods:
            try:
                if method.getName() != name:
                    continue
                method.setAccessible(True)
                found.append(method)
            except Exception:
                continue
        try:
            clazz = clazz.getSuperclass()
        except Exception:
            break

    found.sort(key=lambda item: len(item.getParameterTypes()))
    return found


def _find_method(java_object, name, argc):
    for method in _find_methods(java_object, name):
        if len(method.getParameterTypes()) == argc:
            return method
    return None


def _invoke(method, target, arguments):
    try:
        return method.invoke(target, *arguments)
    except TypeError:
        boxed = jarray(Object)(len(arguments))
        for index, value in enumerate(arguments):
            boxed[index] = value
        return method.invoke(target, boxed)


def _call(java_object, name, arguments=()):
    if java_object is None:
        return None
    try:
        return getattr(java_object, name)(*arguments)
    except Exception:
        pass
    method = _find_method(java_object, name, len(arguments))
    if method is None:
        return None
    try:
        return _invoke(method, java_object, list(arguments))
    except Exception:
        return None


def _class_name(value):
    try:
        return str(value.getClass().getName())
    except Exception:
        return type(value).__name__


def _messages_of(response):
    """Список сообщений из ответа TL — напрямую или через рефлексию."""
    if response is None:
        return None
    holder = None
    try:
        holder = response.messages
    except Exception:
        holder = None
    if holder is None:
        try:
            holder = get_private_field(response, "messages")
        except Exception:
            holder = None
    if holder is None:
        return None
    return _as_list(holder)


def _field(java_object, name):
    """Поле объекта: напрямую, иначе рефлексией."""
    if java_object is None:
        return None
    try:
        value = getattr(java_object, name)
        if value is not None:
            return value
    except Exception:
        pass
    try:
        return get_private_field(java_object, name)
    except Exception:
        return None


def _peer_channel_id(peer):
    """channel_id из TLRPC.Peer, если это канал или супергруппа."""
    if peer is None:
        return None
    for name in ("channel_id", "chat_id"):
        value = _field(peer, name)
        if value:
            try:
                number = int(value)
            except Exception:
                continue
            if number:
                return abs(number)
    return None


def _source_channel(message):
    """Откуда прилетел пост: id канала-источника или None."""
    forward = _field(message, "fwd_from")
    if forward is not None:
        for name in ("from_id", "saved_from_peer", "saved_peer"):
            channel_id = _peer_channel_id(_field(forward, name))
            if channel_id:
                return channel_id

    # Автопост канала в обсуждении приходит от имени самого канала.
    channel_id = _peer_channel_id(_field(message, "saved_from_peer"))
    if channel_id:
        return channel_id
    return _peer_channel_id(_field(message, "from_id"))


KEEP_AUTHORS_DEFAULT = "nobody, максим дуров, SaturnMods"


def _norm_name(text):
    """Имя без эмодзи, скобок и регистра — для сравнения подписей."""
    if text is None:
        return ""
    lowered = str(text).lower()
    cleaned = re.sub(r"[^0-9a-zа-яё@_]+", " ", lowered)
    return re.sub(r"\s+", " ", cleaned).strip()


def _parse_names(raw):
    names = []
    for piece in str(raw or "").split(","):
        norm = _norm_name(piece)
        if norm:
            names.append(norm)
    return names


def _name_matches(title, patterns):
    norm = _norm_name(title)
    if not norm:
        return False
    for pattern in patterns:
        if pattern == norm or pattern in norm:
            return True
    return False


def _peer_kind_id(peer):
    """('u'|'c', id) для TLRPC.Peer, или None."""
    if peer is None:
        return None
    for name, kind in (("user_id", "u"), ("channel_id", "c"), ("chat_id", "c")):
        value = _field(peer, name)
        if value:
            try:
                number = abs(int(value))
            except Exception:
                continue
            if number:
                return kind, number
    return None


def _author_key(message):
    """Кто написал пост: ('n', подпись) / ('u', id) / ('c', id) / ('?', None).

    Подпись под постом канала точнее from_id: там всегда сам канал.
    """
    for holder in (message, _field(message, "fwd_from")):
        signature = _field(holder, "post_author")
        if signature:
            text = str(signature).strip()
            if text:
                return "n", text

    author = _peer_kind_id(_field(message, "from_id"))
    if author:
        return author

    peer = _peer_kind_id(_field(message, "peer_id"))
    if peer:
        return peer
    return "?", None


def _content_kind(message):
    """Во что этот пост: файл, фото, видео, музыка, голосовое, GIF или текст."""
    media = _field(message, "media")
    if media is None or isinstance(media, TLRPC.TL_messageMediaEmpty):
        return "Без вложений (текст)"
    if isinstance(media, TLRPC.TL_messageMediaWebPage):
        return "Ссылки с превью"
    if isinstance(media, TLRPC.TL_messageMediaPhoto):
        return "Фото"
    if isinstance(media, TLRPC.TL_messageMediaDocument):
        document = _field(media, "document")
        attributes = _as_list(_field(document, "attributes")) or []
        for attribute in attributes:
            if isinstance(attribute, TLRPC.TL_documentAttributeAnimated):
                return "GIF"
            if isinstance(attribute, TLRPC.TL_documentAttributeSticker):
                return "Стикеры"
            if isinstance(attribute, TLRPC.TL_documentAttributeVideo):
                return "Видео"
            if isinstance(attribute, TLRPC.TL_documentAttributeAudio):
                if _field(attribute, "voice"):
                    return "Голосовые"
                return "Музыка"
        return "Файлы (документы)"
    return "Прочие вложения"


def _has_document(message):
    media = _field(message, "media")
    if media is None:
        return False
    return isinstance(media, TLRPC.TL_messageMediaDocument)


def _has_media(message):
    media = _field(message, "media")
    if media is None:
        return False
    if isinstance(media, TLRPC.TL_messageMediaWebPage):
        return False
    if isinstance(media, TLRPC.TL_messageMediaEmpty):
        return False
    return True


def _message_id(message):
    """id поста: поле, геттер или рефлексия — что сработает."""
    try:
        return int(message.id)
    except Exception:
        pass
    value = _call(message, "getId")
    if value is not None:
        try:
            return int(value)
        except Exception:
            pass
    try:
        return int(get_private_field(message, "id"))
    except Exception:
        return None


def _array_get(java_array, index):
    try:
        return java_array[index]
    except Exception:
        pass
    try:
        return Array.get(java_array, index)
    except Exception:
        return None


def _as_list(value):
    if value is None:
        return None
    try:
        return list(value)
    except Exception:
        pass
    size_method = _find_method(value, "size", 0)
    get_method = _find_method(value, "get", 1)
    if size_method is None or get_method is None:
        return None
    try:
        count = int(_invoke(size_method, value, []))
    except Exception:
        return None
    items = []
    for index in range(count):
        try:
            items.append(_invoke(get_method, value, [Integer(int(index))]))
        except Exception:
            continue
    return items


def _first_field(java_object, names):
    for name in names:
        try:
            value = get_private_field(java_object, name)
        except Exception:
            value = None
        if value is not None:
            return name, value
    return None, None


def _delete_args(parameter_types, id_list, dialog_id, cache_only=False):
    """Подбирает аргументы MessagesController.deleteMessages по типам параметров.

    Порядок boolean-полей в клиенте — forAll, затем cacheOnly.
    """
    arguments = []
    lists = 0
    longs = 0
    booleans = 0
    has_cache_flag = sum(1 for p in parameter_types if str(p.getName()) == "boolean") >= 2

    for parameter in parameter_types:
        name = str(parameter.getName())
        if name in ("java.util.ArrayList", "java.util.List"):
            lists += 1
            arguments.append(id_list if lists == 1 else None)
        elif name == "long":
            longs += 1
            arguments.append(Long(int(dialog_id)) if longs == 1 else Long(0))
        elif name == "boolean":
            booleans += 1
            if booleans == 1:
                arguments.append(Boolean(not cache_only))
            elif booleans == 2:
                arguments.append(Boolean(cache_only))
            else:
                arguments.append(Boolean(False))
        elif name == "int":
            arguments.append(Integer(0))
        else:
            arguments.append(None)

    if cache_only and not has_cache_flag:
        # Без флага cacheOnly вызов ушёл бы на сервер — такую перегрузку пропускаем.
        return None

    return arguments


