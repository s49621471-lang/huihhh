"""
Выделить все — плагин для exteraGram.

Добавляет в меню профиля канала пункт, который отмечает сразу все загруженные
элементы открытой вкладки общих медиа («Файлы», «Медиа», «Музыка» и т.д.),
чтобы дальше удалить их штатной корзиной Telegram.
"""

import re
import threading
import time
import traceback

from java import jarray
from java.lang import Integer, Object
from java.lang.reflect import Array

from org.telegram.tgnet import TLRPC

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from android_utils import log, run_on_ui_thread
from client_utils import get_last_fragment, get_messages_controller, send_request
from hook_utils import get_private_field
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text

__id__ = "select_all_files"
__name__ = "Выделить все"
__description__ = (
    "Пункт «Выделить все» в меню канала: отмечает все загруженные элементы "
    "открытой вкладки общих медиа, чтобы удалить их штатной корзиной."
)
__author__ = "ENI"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"

DEFAULT_LIMIT = "100"

# Индексы вкладок SharedMediaLayout в клиенте Telegram.
TAB_NAMES = {
    0: "Медиа",
    1: "Файлы",
    2: "Голосовые",
    3: "Ссылки",
    4: "Музыка",
    5: "GIF",
}

LAYOUT_FIELDS = ("sharedMediaLayout", "mediaLayout", "sharedMediaLayoutView")
DATA_FIELDS = ("sharedMediaData",)
ADAPTER_FIELDS = (
    "documentsAdapter",
    "photoVideoAdapter",
    "audioAdapter",
    "voiceAdapter",
    "linksAdapter",
    "gifAdapter",
)

LIST_FIELDS = ("listView", "recyclerListView", "recyclerView")

LOAD_ROUNDS = 40
LOAD_PAUSE = 0.7
LOAD_STALLS = 3

DIALOG_FIELDS = ("dialog_id", "dialogId", "currentDialogId")

KEEP_DEFAULT = "44"
PAGE_LIMIT = 100
DELETE_CHUNK = 100
PAGE_PAUSE = 0.2
CHUNK_PAUSE = 0.35
MAX_PAGES = 500
REQUEST_TIMEOUT = 45.0


def _parse_ids(raw):
    """'44', '44, 45' и ссылки t.me/c/.../44 — всё в набор номеров."""
    result = set()
    if not raw:
        return result
    for token in re.split(r"[\s,;]+", str(raw)):
        numbers = re.findall(r"\d+", token or "")
        if not numbers:
            continue
        try:
            result.add(int(numbers[-1]))
        except Exception:
            continue
    return result


def _error_text(error):
    if error is None:
        return "неизвестная ошибка"
    try:
        return getattr(error, "text", None) or str(error)
    except Exception:
        return "неизвестная ошибка"


def _flood_wait(error):
    match = re.search(r"FLOOD_WAIT_(\d+)", _error_text(error) or "")
    return int(match.group(1)) if match else 0


def _filter_for_tab(tab):
    """Фильтр messages.search, соответствующий вкладке общих медиа."""
    try:
        if tab == 0:
            return TLRPC.TL_inputMessagesFilterPhotoVideo()
        if tab == 2:
            return TLRPC.TL_inputMessagesFilterVoice()
        if tab == 3:
            return TLRPC.TL_inputMessagesFilterUrl()
        if tab == 4:
            return TLRPC.TL_inputMessagesFilterMusic()
        if tab == 5:
            return TLRPC.TL_inputMessagesFilterGif()
        return TLRPC.TL_inputMessagesFilterDocument()
    except Exception:
        return None


def _parse_limit(raw, fallback=100):
    try:
        value = int(str(raw).strip())
    except Exception:
        return fallback
    if value < 1:
        return fallback
    return value


def _find_method(java_object, name, argc):
    """Ищет метод по имени и числу аргументов, поднимаясь по иерархии классов."""
    try:
        clazz = java_object.getClass()
    except Exception:
        return None

    while clazz is not None:
        try:
            methods = clazz.getDeclaredMethods()
        except Exception:
            methods = []
        for method in methods:
            try:
                if method.getName() != name:
                    continue
                if len(method.getParameterTypes()) != argc:
                    continue
                method.setAccessible(True)
                return method
            except Exception:
                continue
        try:
            clazz = clazz.getSuperclass()
        except Exception:
            return None
    return None


def _invoke(method, target, arguments):
    """Method.invoke с varargs, с запасным вариантом через явный jarray."""
    try:
        return method.invoke(target, *arguments)
    except TypeError:
        boxed = jarray(Object)(len(arguments))
        for index, value in enumerate(arguments):
            boxed[index] = value
        return method.invoke(target, boxed)


def _class_name(value):
    try:
        return str(value.getClass().getName())
    except Exception:
        return type(value).__name__


def _array_get(java_array, index):
    """Элемент Java-массива, полученного рефлексией (его статический тип — Object)."""
    try:
        return java_array[index]
    except Exception:
        pass
    try:
        return Array.get(java_array, index)
    except Exception:
        return None


def _call(java_object, name, arguments=()):
    """Вызов метода: сначала напрямую, иначе через рефлексию по реальному классу."""
    if java_object is None:
        return None
    try:
        return getattr(java_object, name)(*arguments)
    except Exception:
        pass
    method = _find_method(java_object, name, len(arguments))
    if method is None:
        return None
    try:
        return _invoke(method, java_object, list(arguments))
    except Exception:
        return None


def _as_list(value):
    """Читает java.util.List, даже если рефлексия вернула его как Object."""
    if value is None:
        return None

    try:
        return list(value)
    except Exception:
        pass

    size_method = _find_method(value, "size", 0)
    get_method = _find_method(value, "get", 1)
    if size_method is None or get_method is None:
        return None

    try:
        count = int(_invoke(size_method, value, []))
    except Exception:
        return None

    items = []
    for index in range(count):
        try:
            items.append(_invoke(get_method, value, [Integer(int(index))]))
        except Exception:
            continue
    return items


def _sparse_size(sparse):
    method = _find_method(sparse, "size", 0)
    if method is None:
        return 0
    try:
        return int(_invoke(method, sparse, []))
    except Exception:
        return 0


def _sparse_put(sparse, key, value):
    method = _find_method(sparse, "put", 2)
    if method is None:
        return False
    try:
        _invoke(method, sparse, [Integer(int(key)), value])
        return True
    except Exception:
        return False


def _first_field(java_object, names):
    for name in names:
        try:
            value = get_private_field(java_object, name)
        except Exception:
            value = None
        if value is not None:
            return name, value
    return None, None


class SelectAllPlugin(BasePlugin):
    def on_plugin_load(self):
        self._items = []
        self._busy = False
        self._dialog = None

        entries = (
            ("Удалить все файлы", "msg_delete", "Найти и удалить пачками по 100", self._on_delete_click, 7),
            ("Выделить все", "msg_select", "Отметить всё на открытой вкладке", self._on_click, 6),
        )

        for menu_type in (
            MenuItemType.PROFILE_ACTION_MENU,
            MenuItemType.CHAT_ACTION_MENU,
        ):
            for text, icon, subtext, handler, priority in entries:
                try:
                    item_id = self.add_menu_item(
                        MenuItemData(
                            menu_type=menu_type,
                            text=text,
                            icon=icon,
                            subtext=subtext,
                            on_click=handler,
                            priority=priority,
                        )
                    )
                    if item_id:
                        self._items.append(item_id)
                except Exception:
                    log("[select_all_files] меню не добавлено:\n" + traceback.format_exc())
        self.log("плагин загружен")

    def on_plugin_unload(self):
        for item_id in self._items:
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass
        self._items = []

    # ------------------------------------------------------------------
    # Настройки
    # ------------------------------------------------------------------

    def create_settings(self):
        return [
            Header(text="Удаление очередью"),
            Text(
                text="Удалить все файлы",
                subtext="Найдёт всё через API и удалит пачками по 100",
                icon="msg_delete",
                red=True,
                on_click=lambda view=None: self._on_delete_click({}),
            ),
            Input(
                key="keep_ids",
                text="Не удалять посты",
                default=KEEP_DEFAULT,
                subtext="ID через запятую. Можно вставлять ссылки вида t.me/c/2053026588/44.",
                icon="msg_pin",
            ),
            Divider(
                text=(
                    "Прокрутка не нужна: список берётся с сервера целиком, удаление идёт "
                    "подряд с прогрессом. Перед удалением показывается, сколько нашлось."
                )
            ),
            Header(text="Выделение"),
            Input(
                key="limit",
                text="Максимум за раз",
                default=DEFAULT_LIMIT,
                subtext="Штатный предел Telegram — 100. Больше можно, но клиент к этому не готов.",
                icon="msg_limit_hit",
            ),
            Switch(
                key="show_total",
                text="Показывать, сколько всего и сколько останется",
                default=True,
                subtext="Общее число берётся с сервера, поэтому видно реальный остаток.",
                icon="msg_info",
            ),
            Switch(
                key="auto_load",
                text="Докручивать список сам",
                default=True,
                subtext=(
                    "Плагин сам прокручивает вкладку вниз, пока клиент не подгрузит "
                    "нужное количество. Иначе отмечается только видимое."
                ),
                icon="msg_download",
            ),
            Switch(
                key="force",
                text="Обходить проверки клиента",
                default=False,
                subtext=(
                    "Писать выделение напрямую, минуя ограничения. Нужно, если обычный "
                    "способ не сработал: зажмите любой файл, потом жмите «Выделить все»."
                ),
                icon="msg_warning",
            ),
            Divider(),
            Text(
                text="Выделить все на открытой вкладке",
                icon="msg_select",
                accent=True,
                on_click=lambda view=None: self._on_click({}),
            ),
            Divider(
                text=(
                    "Откройте канал → вкладку «Файлы», прокрутите список настолько, "
                    "насколько хотите выделить, и нажмите «Выделить все». Отмечаются "
                    "только подгруженные элементы: докрутите ниже и повторите."
                )
            ),
        ]

    # ------------------------------------------------------------------
    # Поиск нужных объектов в клиенте
    # ------------------------------------------------------------------

    def _layout(self):
        fragment = get_last_fragment()
        if fragment is None:
            raise RuntimeError("нет открытого экрана")

        name, layout = _first_field(fragment, LAYOUT_FIELDS)
        if layout is None:
            raise RuntimeError(
                "на этом экране нет общих медиа — откройте профиль канала и вкладку «Файлы»"
            )
        log("[select_all_files] layout найден в поле %s" % name)
        return layout

    def _tab(self, layout):
        for method_name in ("getSelectedTab", "getClosestTab"):
            method = _find_method(layout, method_name, 0)
            if method is None:
                continue
            try:
                return int(_invoke(method, layout, []))
            except Exception:
                continue

        value = get_private_field(layout, "selectedTab")
        if value is not None:
            try:
                return int(value)
            except Exception:
                pass
        return 1

    def _messages(self, layout, tab):
        name, data = _first_field(layout, DATA_FIELDS)
        if data is None:
            raise RuntimeError("не нашёл список медиа в этом окне")

        bucket = _array_get(data, tab)
        if bucket is None:
            raise RuntimeError("вкладка «%s» ещё не загружена" % TAB_NAMES.get(tab, tab))

        messages = None
        for field in ("messages", "messagesList"):
            try:
                messages = get_private_field(bucket, field)
            except Exception:
                messages = None
            if messages is not None:
                break

        if messages is None:
            raise RuntimeError("не нашёл сообщения вкладки «%s»" % TAB_NAMES.get(tab, tab))

        items = _as_list(messages)
        if items is None:
            raise RuntimeError(
                "список сообщений не читается (%s)" % _class_name(messages)
            )
        log(
            "[select_all_files] вкладка %s: поле %s, список %s, элементов %d"
            % (tab, name, _class_name(messages), len(items))
        )
        return items

    def _selected_count(self, layout):
        selected = get_private_field(layout, "selectedFiles")
        if selected is None:
            return 0
        total = 0
        for index in (0, 1):
            bucket = _array_get(selected, index)
            if bucket is None:
                continue
            total += _sparse_size(bucket)
        return total

    # ------------------------------------------------------------------
    # Само выделение
    # ------------------------------------------------------------------

    def _enter_selection(self, layout, tab, messages):
        """Включает штатный режим выделения длинным нажатием по первому элементу."""
        long_click = _find_method(layout, "onItemLongClick", 3)
        if long_click is None:
            return False
        before = self._selected_count(layout)
        try:
            _invoke(long_click, layout, [messages[0], None, Integer(int(tab))])
        except Exception:
            log("[select_all_files] onItemLongClick упал:\n" + traceback.format_exc())
            return False
        return self._selected_count(layout) > before

    def _select_standard(self, layout, tab, messages, limit):
        """Штатный путь: клики по элементам после включённого режима выделения."""
        item_click = _find_method(layout, "onItemClick", 5)
        if item_click is None:
            return None

        selected = 1
        for index in range(1, min(len(messages), limit)):
            try:
                _invoke(
                    item_click,
                    layout,
                    [
                        Integer(int(index)),
                        None,
                        messages[index],
                        Integer(int(tab)),
                        Integer(int(tab)),
                    ],
                )
                selected += 1
            except Exception:
                log("[select_all_files] пропуск элемента %d:\n%s" % (index, traceback.format_exc()))

        return selected

    def _select_forced(self, layout, messages, limit):
        """Запасной путь: запись прямо в selectedFiles, режим выделения уже должен быть включён."""
        selected = get_private_field(layout, "selectedFiles")
        if selected is None:
            raise RuntimeError("не нашёл список выделенного (selectedFiles)")

        bucket = _array_get(selected, 0)
        if bucket is None:
            raise RuntimeError(
                "не читается selectedFiles (%s)" % _class_name(selected)
            )

        added = 0
        for message in messages[:limit]:
            message_id = _call(message, "getId")
            if message_id is None:
                continue
            try:
                message_id = int(message_id)
            except Exception:
                continue
            if _sparse_put(bucket, message_id, message):
                added += 1

        self._refresh(layout)
        return added

    def _refresh(self, layout):
        for field in ADAPTER_FIELDS:
            try:
                adapter = get_private_field(layout, field)
            except Exception:
                adapter = None
            if adapter is None:
                continue
            _call(adapter, "notifyDataSetChanged")
        _call(layout, "invalidate")

    # ------------------------------------------------------------------
    # Догрузка списка
    # ------------------------------------------------------------------

    def _list_views(self, layout):
        """RecyclerView'ы вкладок — их прокрутка заставляет клиент подгружать медиа."""
        views = []
        pages = get_private_field(layout, "mediaPages")
        if pages is None:
            return views
        for index in range(2):
            page = _array_get(pages, index)
            if page is None:
                continue
            _, view = _first_field(page, LIST_FIELDS)
            if view is not None:
                views.append(view)
        return views

    def _load_more(self, layout, tab, limit):
        """Прокручивает список вниз, пока клиент подгружает новые элементы."""
        views = self._list_views(layout)
        if not views:
            log("[select_all_files] не нашёл списки вкладок, догрузка пропущена")
            return self._messages(layout, tab)

        messages = self._messages(layout, tab)
        stalls = 0

        for _ in range(LOAD_ROUNDS):
            if len(messages) >= limit:
                break

            position = max(len(messages) - 1, 0)
            for view in views:
                run_on_ui_thread(
                    lambda v=view, p=position: _call(v, "scrollToPosition", [Integer(int(p))])
                )

            time.sleep(LOAD_PAUSE)

            grown = self._messages(layout, tab)
            if len(grown) <= len(messages):
                stalls += 1
                if stalls >= LOAD_STALLS:
                    break
            else:
                stalls = 0
            messages = grown

        return messages

    # ------------------------------------------------------------------
    # Сколько всего таких постов в канале
    # ------------------------------------------------------------------

    def _dialog_id(self, layout, context):
        for key in ("dialog_id", "dialogId"):
            try:
                value = (context or {}).get(key)
            except Exception:
                value = None
            if value:
                return int(value)

        _, value = _first_field(layout, DIALOG_FIELDS)
        if value:
            try:
                return int(value)
            except Exception:
                pass

        try:
            chat = (context or {}).get("chat")
            if chat is not None:
                chat_id = int(_call(chat, "getId") or get_private_field(chat, "id"))
                return -(1000000000000 + chat_id) if chat_id > 0 else chat_id
        except Exception:
            pass
        return None

    def _total_in_channel(self, dialog_id, tab):
        """Общее число постов такого типа — счётчик отдаёт сам сервер."""
        if not dialog_id:
            return None

        media_filter = _filter_for_tab(tab)
        if media_filter is None:
            return None

        try:
            request = TLRPC.TL_messages_search()
            request.peer = get_messages_controller().getInputPeer(dialog_id)
            request.q = ""
            request.filter = media_filter
            request.min_date = 0
            request.max_date = 0
            request.offset_id = 0
            request.add_offset = 0
            request.limit = 1
            request.max_id = 0
            request.min_id = 0
            for field in ("hash", "hash_"):
                try:
                    setattr(request, field, 0)
                except Exception:
                    pass
        except Exception:
            log("[select_all_files] запрос счётчика не собрался:\n" + traceback.format_exc())
            return None

        box = {}
        event = threading.Event()

        def callback(response, error):
            box["response"] = response
            box["error"] = error
            event.set()

        send_request(request, callback)
        if not event.wait(20):
            return None

        response = box.get("response")
        if response is None:
            return None

        count = getattr(response, "count", None)
        if not count:
            try:
                count = len(list(response.messages))
            except Exception:
                count = None
        try:
            return int(count)
        except Exception:
            return None

    # ------------------------------------------------------------------
    # Удаление очередью: всё через API, без прокрутки и без корзины
    # ------------------------------------------------------------------

    def _request(self, request, timeout=REQUEST_TIMEOUT):
        box = {}
        event = threading.Event()

        def callback(response, error):
            box["response"] = response
            box["error"] = error
            event.set()

        send_request(request, callback)
        if not event.wait(timeout):
            raise RuntimeError("Telegram не ответил за %d с" % int(timeout))
        return box.get("response"), box.get("error")

    def _request_retrying(self, request, attempts=3):
        last = None
        for _ in range(attempts):
            response, error = self._request(request)
            if error is None:
                return response, None
            wait = _flood_wait(error)
            last = error
            if wait <= 0 or wait > 300:
                return None, error
            time.sleep(wait + 1)
        return None, last

    def _search_page(self, dialog_id, tab, offset_id):
        request = TLRPC.TL_messages_search()
        request.peer = get_messages_controller().getInputPeer(dialog_id)
        request.q = ""
        request.filter = _filter_for_tab(tab)
        request.min_date = 0
        request.max_date = 0
        request.offset_id = offset_id
        request.add_offset = 0
        request.limit = PAGE_LIMIT
        request.max_id = 0
        request.min_id = 0
        for field in ("hash", "hash_"):
            try:
                setattr(request, field, 0)
            except Exception:
                pass
        return request

    def _collect_ids(self, dialog_id, tab, keep_ids):
        """Все id постов такого типа — постранично, минуя интерфейс."""
        ids = []
        seen = set()
        offset_id = 0

        for _ in range(MAX_PAGES):
            response, error = self._request_retrying(
                self._search_page(dialog_id, tab, offset_id)
            )
            if error is not None:
                raise RuntimeError("Ошибка поиска: %s" % _error_text(error))
            if response is None:
                break

            try:
                messages = list(response.messages)
            except Exception:
                messages = []
            if not messages:
                break

            lowest = offset_id
            for message in messages:
                try:
                    message_id = int(message.id)
                except Exception:
                    continue
                if lowest == 0 or message_id < lowest:
                    lowest = message_id
                if message_id in seen or message_id in keep_ids:
                    continue
                seen.add(message_id)
                ids.append(message_id)

            self._update_progress("Собираю список", "Найдено: %d" % len(ids))

            if len(messages) < PAGE_LIMIT:
                break
            if lowest <= 1 or (offset_id > 0 and lowest >= offset_id):
                break
            offset_id = lowest
            time.sleep(PAGE_PAUSE)

        ids.sort()
        return ids

    def _delete_request(self, dialog_id, chunk):
        peer = get_messages_controller().getInputPeer(dialog_id)
        if isinstance(peer, TLRPC.TL_inputPeerChannel):
            request = TLRPC.TL_channels_deleteMessages()
            channel = TLRPC.TL_inputChannel()
            channel.channel_id = peer.channel_id
            channel.access_hash = peer.access_hash
            request.channel = channel
        else:
            request = TLRPC.TL_messages_deleteMessages()
            request.revoke = True
        for message_id in chunk:
            request.id.add(Integer(int(message_id)))
        return request

    def _on_delete_click(self, context=None):
        if self._busy:
            BulletinHelper.show_info("Подождите, операция уже идёт")
            return
        self._busy = True
        threading.Thread(target=self._delete_job, args=(context,), daemon=True).start()

    def _delete_job(self, context):
        try:
            layout = None
            tab = 1
            try:
                layout = self._layout()
                tab = self._tab(layout)
            except Exception:
                log("[select_all_files] экрана медиа нет, беру вкладку «Файлы»")

            dialog_id = self._dialog_id(layout, context)
            if not dialog_id:
                raise RuntimeError("не понял, какой это канал — откройте его профиль")

            keep_ids = _parse_ids(self.get_setting("keep_ids", KEEP_DEFAULT))
            self._show_progress("Собираю список", "Найдено: 0")
            ids = self._collect_ids(dialog_id, tab, keep_ids)
            self._dismiss_progress()

            run_on_ui_thread(lambda: self._confirm_delete(dialog_id, tab, ids, keep_ids))
        except Exception as exception:
            log("[select_all_files] сбор не удался:\n" + traceback.format_exc())
            message = str(exception)
            self._dismiss_progress()
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не вышло: %s" % message))

    def _confirm_delete(self, dialog_id, tab, ids, keep_ids):
        self._busy = False
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None

        if not ids:
            if activity is None:
                BulletinHelper.show_info("Удалять нечего")
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("Нечего удалять")
            builder.set_message(
                "На вкладке «%s» постов не нашлось." % TAB_NAMES.get(tab, tab)
            )
            builder.set_positive_button("Ок", lambda b, w: b.dismiss())
            builder.show()
            return

        if activity is None:
            BulletinHelper.show_error("Нет активного окна для подтверждения")
            return

        preview = ", ".join("#%d" % value for value in ids[:12])
        if len(ids) > 12:
            preview += " …"

        message = [
            "Постов к удалению: %d" % len(ids),
            "Пачками по %d, подряд, без ручного выделения." % DELETE_CHUNK,
            "",
            preview,
        ]
        if keep_ids:
            message.append("")
            message.append(
                "Не трогаю: %s" % ", ".join("#%d" % value for value in sorted(keep_ids))
            )
        message.append("")
        message.append("Удаление в канале необратимо.")

        builder = AlertDialogBuilder(activity)
        builder.set_title("Удалить %d постов?" % len(ids))
        builder.set_message("\n".join(message))
        builder.set_positive_button(
            "Удалить всё",
            lambda b, w: (b.dismiss(), self._start_delete(dialog_id, ids)),
        )
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.create()
        builder.show()
        try:
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass

    def _start_delete(self, dialog_id, ids):
        self._busy = True
        self._show_progress(
            "Удаляю 0 из %d" % len(ids),
            "Осталось: %d\nНе удалось: 0" % len(ids),
            determinate=True,
        )
        threading.Thread(
            target=self._delete_worker, args=(dialog_id, ids), daemon=True
        ).start()

    def _delete_worker(self, dialog_id, ids):
        deleted = 0
        failed = []
        try:
            for start in range(0, len(ids), DELETE_CHUNK):
                chunk = ids[start : start + DELETE_CHUNK]
                response, error = self._request_retrying(
                    self._delete_request(dialog_id, chunk)
                )
                if error is not None:
                    failed.extend(chunk)
                    log("[select_all_files] пачка не удалена (%s)" % _error_text(error))
                else:
                    deleted += len(chunk)

                done = deleted + len(failed)
                self._update_progress(
                    "Удаляю %d из %d" % (deleted, len(ids)),
                    "Осталось: %d\nНе удалось: %d" % (len(ids) - done, len(failed)),
                    percent=int(done * 100 / max(len(ids), 1)),
                )
                if start + DELETE_CHUNK < len(ids):
                    time.sleep(CHUNK_PAUSE)
        except Exception as exception:
            log("[select_all_files] удаление сорвалось:\n" + traceback.format_exc())
            message = str(exception)
            self._dismiss_progress()
            self._busy = False
            run_on_ui_thread(lambda: BulletinHelper.show_error("Сбой: %s" % message))
            return

        self._dismiss_progress()
        self._busy = False
        run_on_ui_thread(lambda: self._delete_result(deleted, failed, len(ids)))

    def _delete_result(self, deleted, failed, total):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_success("Удалено %d из %d" % (deleted, total))
            return

        lines = ["Удалено: %d из %d" % (deleted, total), "Не удалось: %d" % len(failed)]
        if failed:
            preview = ", ".join("#%d" % value for value in failed[:15])
            if len(failed) > 15:
                preview += " …"
            lines.append("")
            lines.append("Остались: %s" % preview)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Готово" if not failed else "Готово с ошибками")
        builder.set_message("\n".join(lines))
        builder.set_positive_button("Ок", lambda b, w: b.dismiss())
        builder.show()

    # ------------------------------------------------------------------
    # Прогресс
    # ------------------------------------------------------------------

    def _show_progress(self, title, message, determinate=False):
        def build():
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None:
                return
            style = (
                AlertDialogBuilder.ALERT_TYPE_LOADING
                if determinate
                else AlertDialogBuilder.ALERT_TYPE_SPINNER
            )
            builder = AlertDialogBuilder(activity, style)
            builder.set_title(title)
            builder.set_message(message)
            builder.show()
            try:
                builder.set_cancelable(False)
            except Exception:
                pass
            self._dialog = builder

        run_on_ui_thread(build)

    def _update_progress(self, title, message, percent=None):
        def apply():
            builder = self._dialog
            if builder is None:
                return
            try:
                builder.set_title(title)
                builder.set_message(message)
            except Exception:
                pass
            if percent is not None:
                try:
                    builder.set_progress(max(0, min(100, int(percent))))
                except Exception:
                    pass

        run_on_ui_thread(apply)

    def _dismiss_progress(self):
        def close():
            builder = self._dialog
            self._dialog = None
            if builder is None:
                return
            try:
                builder.dismiss()
            except Exception:
                pass

        run_on_ui_thread(close)

    def _on_click(self, context=None):
        threading.Thread(target=self._run, args=(context,), daemon=True).start()

    def _run(self, context=None):
        try:
            limit = _parse_limit(self.get_setting("limit", DEFAULT_LIMIT))
            layout = self._layout()
            tab = self._tab(layout)
            messages = self._messages(layout, tab)

            total = None
            if self.get_setting("show_total", True):
                total = self._total_in_channel(self._dialog_id(layout, context), tab)

            if messages and len(messages) < limit and self.get_setting("auto_load", True):
                BulletinHelper.show_info("Докручиваю список, подождите")
                messages = self._load_more(layout, tab, limit)

            if not messages:
                BulletinHelper.show_error(
                    "На вкладке «%s» пока ничего не загружено" % TAB_NAMES.get(tab, tab)
                )
                return

            # Выделение трогает вьюхи клиента, поэтому только на UI-потоке.
            run_on_ui_thread(lambda: self._select(layout, tab, messages, limit, total))
        except Exception as exception:
            log("[select_all_files] ошибка подготовки:\n" + traceback.format_exc())
            BulletinHelper.show_error("Не вышло: %s" % exception)

    def _select(self, layout, tab, messages, limit, total=None):
        try:
            forced = bool(self.get_setting("force", False))
            selected = None
            entered = self._enter_selection(layout, tab, messages)

            if not forced and entered:
                selected = self._select_standard(layout, tab, messages, limit)

            if selected is None:
                selected = self._select_forced(layout, messages, limit)
                if not forced:
                    log(
                        "[select_all_files] штатный путь не сработал (режим выделения: %s), "
                        "ушли в прямую запись" % entered
                    )

            marked = self._selected_count(layout) or selected
            log(
                "[select_all_files] вкладка=%s загружено=%d выделено=%d отмечено=%d всего в канале=%s"
                % (tab, len(messages), selected, marked, total)
            )

            if total:
                left = max(total - marked, 0)
                text = "Отмечено %d из %d · останется %d" % (marked, total, left)
            else:
                text = "Отмечено %d (загружено %d)" % (marked, len(messages))

            if marked >= limit and (not total or total > marked):
                text += " · лимит %d, повторите после удаления" % limit

            BulletinHelper.show_success(text)
        except Exception as exception:
            log("[select_all_files] ошибка выделения:\n" + traceback.format_exc())
            BulletinHelper.show_error("Не вышло: %s" % exception)
