"""
Чистка файлов — плагин для exteraGram.

Кнопка «Удалить все файлы» в меню канала: собирает список постов с вложениями
через API и удаляет их пачками в фоне, не мешая пользоваться клиентом.
Прогресс и подробный лог живут в настройках плагина, лог копируется одним тапом.
"""

import re
import threading
import time
import traceback

from java import jarray
from java.lang import Boolean, Integer, Long, Object
from java.lang.reflect import Array
from java.util import ArrayList

from org.telegram.tgnet import TLRPC

