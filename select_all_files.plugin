TAB_NAMES = {0: "Медиа", 1: "Файлы", 2: "Голосовые", 3: "Ссылки", 4: "Музыка", 5: "GIF"}

TARGET_FILES = 0
TARGET_MEDIA = 1
TARGET_MUSIC = 2
TARGET_VOICE = 3
TARGET_GIF = 4

